---
import ThemeToggle from './ThemeToggle.astro';
import GithubIcon from './icons/GithubIcon.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${baseUrl}/images/nokia-refreshed-logo-2_1.png`;
const homeUrl = `${baseUrl}/` || '/';
---

<header class="sticky top-0 z-50 w-full backdrop-blur-md bg-white/90 dark:bg-[#080c14]/90 border-b border-slate-200/80 dark:border-white/[0.08] transition-colors duration-200">
  <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 gap-3">
      <!-- Left: Logo & Brand Title -->
      <a href={homeUrl} class="group flex items-center gap-2.5 sm:gap-3 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0055ff] rounded-lg">
        <div class="relative overflow-hidden rounded-lg bg-slate-950 dark:bg-black/50 p-1.5 border border-slate-200 dark:border-white/[0.1] shadow-2xs group-hover:border-[#0055ff] dark:group-hover:border-[#00d4ff] transition-colors">
          <img
            src={logoSrc}
            alt="Nokia Logo"
            class="h-6 w-auto object-contain transition-transform duration-200 group-hover:scale-105"
            width="52"
            height="26"
            loading="eager"
          />
        </div>
        <div class="flex items-center gap-2">
          <span class="text-lg font-bold tracking-tight text-slate-900 dark:text-white">
            Awesome <span class="bg-gradient-to-r from-[#0055ff] to-[#00d4ff] bg-clip-text text-transparent">Nokia</span>
          </span>
        </div>
      </a>

      <!-- Right: Links & Theme Toggle -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <!-- Submit Project Link (Pointing to Issues) -->
        <a
          href="https://github.com/andywhitaker/awesome-nokia/issues"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-600 hover:text-slate-900 dark:text-slate-300 dark:hover:text-white rounded-lg hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-colors"
        >
          <span>Submit Project</span>
        </a>

        <!-- GitHub Repo Link -->
        <a
          href="https://github.com/andywhitaker/awesome-nokia"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 dark:text-slate-200 dark:hover:text-white rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-white/[0.06] dark:hover:bg-white/[0.1] border border-slate-200 dark:border-white/[0.08] transition-all duration-150"
          aria-label="Awesome Nokia on GitHub"
        >
          <GithubIcon class="w-3.5 h-3.5" />
          <span class="hidden sm:inline">GitHub</span>
        </a>

        <!-- Dark / Light Mode Toggle -->
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>
