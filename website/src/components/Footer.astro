---
import GithubIcon from './icons/GithubIcon.astro';
import DiscordIcon from './icons/DiscordIcon.astro';
import { GitPullRequest, ExternalLink } from '@lucide/astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${baseUrl}/images/nokia-refreshed-logo-2_1.png`;
---

<footer class="mt-20 border-t border-slate-200/80 dark:border-white/[0.08] bg-white/70 dark:bg-[#060910]/90 backdrop-blur-md">
  <div class="max-w-5xl mx-auto px-4 sm:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      <!-- Col 1: Brand & Description -->
      <div class="space-y-3">
        <div class="flex items-center gap-2.5">
          <div class="bg-slate-950 dark:bg-black/50 p-1.5 rounded-lg border border-slate-200 dark:border-white/[0.1] w-fit shadow-2xs">
            <img
              src={logoSrc}
              alt="Nokia Logo"
              class="h-5 w-auto object-contain"
              width="44"
              height="22"
              loading="lazy"
            />
          </div>
          <span class="text-base font-bold tracking-tight text-slate-900 dark:text-white">Awesome Nokia</span>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed max-w-sm">
          A community-driven directory of awesome open-source projects, automation libraries, extensions, and tools for Nokia networking platforms.
        </p>
      </div>

      <!-- Col 2: Community & Links -->
      <div class="space-y-2.5">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          Community & Links
        </h4>
        <ul class="space-y-2 text-xs sm:text-sm">
          <li>
            <a
              href="https://github.com/andywhitaker/awesome-nokia/issues"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-slate-600 hover:text-[#0055ff] dark:text-slate-400 dark:hover:text-[#00d4ff] transition-colors"
            >
              <GitPullRequest class="w-3.5 h-3.5 text-[#0055ff] dark:text-[#00d4ff]" />
              <span>Submit a Project</span>
            </a>
          </li>
          <li>
            <a
              href="https://github.com/andywhitaker/awesome-nokia"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-slate-600 hover:text-[#0055ff] dark:text-slate-400 dark:hover:text-[#00d4ff] transition-colors"
            >
              <GithubIcon class="w-3.5 h-3.5" />
              <span>GitHub Repository</span>
            </a>
          </li>
          <li>
            <a
              href="https://discord.gg/vAyddtaEV9"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-slate-600 hover:text-[#0055ff] dark:text-slate-400 dark:hover:text-[#00d4ff] transition-colors"
            >
              <DiscordIcon class="w-3.5 h-3.5 text-[#5865F2]" />
              <span>Containerlab Discord</span>
              <ExternalLink class="w-3 h-3 opacity-50" />
            </a>
          </li>
          <li>
            <a
              href="https://discord.gg/tZvgjQ6PZf"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 text-slate-600 hover:text-[#0055ff] dark:text-slate-400 dark:hover:text-[#00d4ff] transition-colors"
            >
              <DiscordIcon class="w-3.5 h-3.5 text-[#5865F2]" />
              <span>SR Linux & SROS Discord</span>
              <ExternalLink class="w-3 h-3 opacity-50" />
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Disclaimer -->
      <div class="space-y-2.5">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-900 dark:text-slate-200">
          About
        </h4>
        <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
          Independent, community-curated ecosystem index. Nokia trademarks belong to Nokia and respective holders.
        </p>
        <div class="pt-1 text-xs text-slate-400 dark:text-slate-500">
          Built with Astro & Tailwind CSS
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-8 pt-6 border-t border-slate-200/80 dark:border-white/[0.08] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <div>
        Maintained by <a href="https://github.com/andywhitaker" target="_blank" rel="noopener noreferrer" class="font-medium text-slate-700 dark:text-slate-300 hover:underline">Andy Whitaker</a> and the Nokia community.
      </div>
      <a href="#top" class="hover:text-slate-900 dark:hover:text-slate-200 transition-colors">Back to top ↑</a>
    </div>
  </div>
</footer>
