---
import { CATEGORIES, RESOURCES } from '../data/resources';
import GithubIcon from './icons/GithubIcon.astro';
import {
  Search,
  ExternalLink,
  Sparkles,
  Code,
  Share2,
  Check,
  SlidersHorizontal,
} from '@lucide/astro';

const totalCount = RESOURCES.length;

const quickTags = ['Official', 'Popular', 'Community', 'telemetry', 'ansible', 'vscode', 'yang', 'clab'];
---

<div id="modern-docs-root" class="w-full relative overflow-hidden">
  <!-- Subtle Fading Grid Pattern Background Overlay at top (matching Portal style) -->
  <div class="absolute inset-x-0 top-0 h-[600px] -z-10 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:36px_36px] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

  <div class="max-w-[1536px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-center relative">
      
      <!-- ========================================== -->
      <!-- 1. LEFT SIDEBAR: Persistent Category Navigation (Pushed to the Left) -->
      <!-- ========================================== -->
      <aside
        id="docs-left-sidebar"
        class="hidden lg:flex flex-col w-64 xl:w-72 shrink-0 sticky top-20 max-h-[calc(100vh-5.5rem)] overflow-y-auto pr-6 py-6 scrollbar-thin text-sm border-r border-slate-200/80 dark:border-white/[0.08]"
        aria-label="Documentation sidebar"
      >
        <!-- Sidebar Search / Filter -->
        <div class="mb-5 relative">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 dark:text-slate-500">
            <SlidersHorizontal class="w-3.5 h-3.5" />
          </div>
          <input
            id="docs-sidebar-filter"
            type="text"
            placeholder="Filter platforms..."
            class="w-full pl-9 pr-3 py-1.5 text-xs rounded-lg bg-slate-100 dark:bg-white/[0.06] text-slate-800 dark:text-slate-200 placeholder-slate-400 border border-slate-200/80 dark:border-white/[0.08] focus:outline-none focus:ring-1 focus:ring-[#0055ff]"
          />
        </div>

        <nav class="space-y-6 flex-1">
          <!-- Section A: Overview -->
          <div>
            <span class="block px-2.5 mb-2 text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
              Navigation
            </span>
            <ul class="space-y-1">
              <li>
                <a
                  href="#docs-overview"
                  class="docs-nav-link flex items-center gap-2 px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.06] hover:text-[#0055ff] dark:hover:text-[#00d4ff] font-medium transition-colors"
                  data-target="docs-overview"
                >
                  <Sparkles class="w-3.5 h-3.5 text-[#0055ff] dark:text-[#00d4ff]" />
                  <span>Overview</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Section B: Ecosystem Categories -->
          <div>
            <div class="flex items-center justify-between px-2.5 mb-2">
              <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
                Ecosystems
              </span>
              <span class="text-[10px] font-mono text-slate-400">7 Platforms</span>
            </div>
            <ul id="docs-sidebar-categories" class="space-y-1">
              {
                CATEGORIES.map((cat) => {
                  const catCount = RESOURCES.filter((r) => r.category === cat.id).length;
                  return (
                    <li>
                      <a
                        href={`#docs-${cat.id}`}
                        class="docs-nav-link group flex items-center justify-between px-2.5 py-1.5 rounded-lg text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-white/[0.06] hover:text-[#0055ff] dark:hover:text-[#00d4ff] font-medium transition-colors"
                        data-target={`docs-${cat.id}`}
                      >
                        <div class="flex items-center gap-2 truncate">
                          <span class="text-sm shrink-0">{cat.emoji}</span>
                          <span class="truncate">{cat.name}</span>
                        </div>
                        <span class="text-[11px] font-mono px-1.5 py-0.5 rounded bg-slate-200/70 dark:bg-white/[0.08] text-slate-600 dark:text-slate-400 group-hover:bg-[#0055ff]/10 dark:group-hover:bg-[#00d4ff]/10 group-hover:text-[#0055ff] dark:group-hover:text-[#00d4ff] transition-colors">
                          {catCount}
                        </span>
                      </a>
                    </li>
                  );
                })
              }
            </ul>
          </div>

          <!-- Section C: Community & Contribution -->
          <div class="pt-4 border-t border-slate-200/80 dark:border-white/[0.08]">
            <span class="block px-2.5 mb-2 text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 dark:text-slate-500">
              Community & Links
            </span>
            <ul class="space-y-1 text-xs">
              <li>
                <a
                  href="https://github.com/andywhitaker/awesome-nokia"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/[0.06] hover:text-slate-900 dark:hover:text-white transition-colors"
                >
                  <div class="flex items-center gap-2">
                    <GithubIcon class="w-3.5 h-3.5" />
                    <span>GitHub Repository</span>
                  </div>
                  <ExternalLink class="w-3 h-3 opacity-60" />
                </a>
              </li>
              <li>
                <a
                  href="https://github.com/andywhitaker/awesome-nokia/issues"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between px-2.5 py-1.5 rounded-lg text-slate-600 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-white/[0.06] hover:text-slate-900 dark:hover:text-white transition-colors"
                >
                  <div class="flex items-center gap-2">
                    <Code class="w-3.5 h-3.5" />
                    <span>Submit Project</span>
                  </div>
                  <ExternalLink class="w-3 h-3 opacity-60" />
                </a>
              </li>
            </ul>
          </div>
        </nav>
      </aside>

      <!-- ========================================== -->
      <!-- 2. MAIN CENTER COLUMN: Documentation Content (Centered on Screen) -->
      <!-- ========================================== -->
      <main class="w-full max-w-4xl px-0 lg:px-8 py-6 pb-24 min-w-0">
        
        <!-- Document Section 1: Overview & Hero (Centered) -->
        <section id="docs-overview" class="doc-section scroll-mt-24 mb-14 text-center pt-4 sm:pt-6">
          <div class="max-w-3xl mx-auto">
            <!-- Centered Badge Pill: Curated Resources -->
            <div class="mb-5 inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-500/10 text-[#0055ff] dark:text-[#00d4ff] text-xs font-mono font-semibold border border-blue-500/20 shadow-2xs">
              <span class="w-1.5 h-1.5 rounded-full bg-[#0055ff] dark:bg-[#00d4ff] animate-pulse"></span>
              <span>{totalCount} Curated Resources</span>
            </div>

            <!-- Bold, Editorial Headline -->
            <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-[1.1] pb-1 font-display">
              <span class="bg-gradient-to-r from-[#0055ff] via-[#0099ff] to-[#00d4ff] bg-clip-text text-transparent">Awesome Nokia</span>
            </h1>

            <!-- Subtitle matching Portal page -->
            <p class="text-base sm:text-lg lg:text-xl text-slate-600 dark:text-slate-300 mt-5 leading-relaxed max-w-2xl mx-auto">
              A curated collection of developer tools, network automation libraries, Containerlab extensions, and telemetry pipelines built by Nokia and the global NetDevOps community.
            </p>
          </div>
        </section>

        <!-- Document Section 2: Live Search Omnibar & Filter Chips -->
        <div id="docs-search-section" class="sticky top-20 z-30 mb-12 p-3 sm:p-4 rounded-2xl bg-slate-50/90 dark:bg-[#080c14]/90 backdrop-blur-md border border-slate-200/90 dark:border-white/[0.08] shadow-md">
          <div class="relative">
            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <Search class="w-4 h-4" />
            </div>
            <input
              id="docs-live-search"
              type="search"
              autocomplete="off"
              spellcheck="false"
              placeholder="Search by title, topic, or tag (e.g. clab, telemetry, yang, pysros)..."
              class="w-full pl-10 pr-20 py-2.5 text-xs sm:text-sm rounded-xl bg-white dark:bg-[#0e1526] text-slate-900 dark:text-white placeholder-slate-400 border border-slate-200 dark:border-white/[0.1] focus:outline-none focus:ring-2 focus:ring-[#0055ff] transition-all shadow-2xs"
            />
            <div class="absolute inset-y-0 right-0 pr-3 flex items-center gap-1.5 pointer-events-none">
              <kbd class="hidden sm:inline-flex items-center justify-center px-1.5 py-0.5 text-[10px] font-mono text-slate-400 bg-slate-100 dark:bg-white/[0.08] border border-slate-200 dark:border-white/[0.1] rounded">
                /
              </kbd>
            </div>
          </div>

          <!-- Quick Tag Filter Chips -->
          <div class="mt-2.5 flex items-center justify-between gap-2 text-xs flex-wrap">
            <div class="flex items-center gap-1.5 flex-wrap">
              <span class="text-[11px] font-mono text-slate-400 uppercase font-semibold">Filter:</span>
              {
                quickTags.map((tag) => (
                  <button
                    type="button"
                    class="docs-tag-filter px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-white/[0.06] text-slate-600 dark:text-slate-400 hover:text-[#0055ff] dark:hover:text-[#00d4ff] hover:bg-blue-50 dark:hover:bg-blue-950/40 border border-slate-200/60 dark:border-white/[0.08] transition-colors cursor-pointer"
                    data-tag={tag}
                  >
                    #{tag}
                  </button>
                ))
              }
            </div>
            <span id="docs-results-count" class="text-xs font-mono text-slate-500 dark:text-slate-400">
              Showing all {totalCount} Curated Resources
            </span>
          </div>
        </div>

        <!-- Document Section 3: Categorized Ecosystem Streams -->
        <div id="docs-categories-container" class="space-y-16">
          {
            CATEGORIES.map((category) => {
              const catResources = RESOURCES.filter((r) => r.category === category.id);
              return (
                <section
                  id={`docs-${category.id}`}
                  class="doc-section doc-category-group scroll-mt-28"
                  data-category={category.id}
                >
                  <!-- Category Section Header -->
                  <div class="pb-4 mb-6 border-b border-slate-200/80 dark:border-white/[0.08]">
                    <div class="flex items-center justify-between gap-4 flex-wrap mb-2">
                      <div class="flex items-center gap-3">
                        <span class="text-2xl p-2 rounded-xl bg-slate-100 dark:bg-white/[0.06] border border-slate-200/80 dark:border-white/[0.08]">
                          {category.emoji}
                        </span>
                        <div>
                          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white font-display">
                            {category.name}
                          </h2>
                          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-0.5">
                            {category.shortDescription}
                          </p>
                        </div>
                      </div>
                      <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-md bg-slate-100 dark:bg-white/[0.06] text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-white/[0.1]">
                        {catResources.length} items
                      </span>
                    </div>
                  </div>

                  <!-- Resources Grid for this Category (Without commands) -->
                  <div class="space-y-4">
                    {catResources.map((res) => (
                      <article
                        id={`doc-item-${res.id}`}
                        class="doc-item group p-5 rounded-2xl bg-white dark:bg-[#0e1526]/80 hover:bg-slate-50/80 dark:hover:bg-[#121b30] border border-slate-200/90 dark:border-white/[0.08] hover:border-[#0055ff]/40 dark:hover:border-[#00d4ff]/40 shadow-2xs hover:shadow-md transition-all duration-200"
                        data-title={res.title.toLowerCase()}
                        data-desc={res.description.toLowerCase()}
                        data-tags={res.tags.join(' ').toLowerCase()}
                        data-category={res.category}
                      >
                        <!-- Card Top Row: Title, Badges & Actions -->
                        <div class="flex items-start justify-between gap-4 mb-2">
                          <div class="flex items-center gap-2.5 flex-wrap">
                            <a
                              href={res.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-base sm:text-lg font-bold text-slate-900 dark:text-white group-hover:text-[#0055ff] dark:group-hover:text-[#00d4ff] transition-colors inline-flex items-center gap-1.5"
                            >
                              <span>{res.title}</span>
                              <ExternalLink class="w-3.5 h-3.5 opacity-40 group-hover:opacity-100 transition-opacity" />
                            </a>

                            {res.badge && (
                              <span
                                class={`text-[11px] font-mono font-bold px-2 py-0.5 rounded-full border ${
                                  res.badge === 'Official'
                                    ? 'bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/30'
                                    : res.badge === 'Popular'
                                    ? 'bg-amber-500/10 text-amber-700 dark:text-amber-300 border-amber-500/30'
                                    : 'bg-emerald-500/10 text-emerald-700 dark:text-emerald-300 border-emerald-500/30'
                                }`}
                              >
                                {res.badge}
                              </span>
                            )}
                          </div>

                          <div class="flex items-center gap-1.5 shrink-0">
                            {res.githubUrl && (
                              <a
                                href={res.githubUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold rounded-lg bg-slate-100 hover:bg-slate-200 dark:bg-white/[0.06] dark:hover:bg-white/[0.12] text-slate-700 dark:text-slate-300 border border-slate-200/80 dark:border-white/[0.08] transition-colors"
                                title="View on GitHub"
                              >
                                <GithubIcon class="w-3.5 h-3.5" />
                                <span class="hidden sm:inline">Repo</span>
                              </a>
                            )}
                            <button
                              type="button"
                              class="docs-copy-link-btn p-1.5 rounded-lg text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-white/[0.06] transition-colors cursor-pointer"
                              data-id={res.id}
                              title="Copy permalink"
                              aria-label={`Copy link for ${res.title}`}
                            >
                              <Share2 class="w-3.5 h-3.5 icon-copy" />
                              <Check class="w-3.5 h-3.5 icon-check hidden text-emerald-500" />
                            </button>
                          </div>
                        </div>

                        <!-- Technical Description -->
                        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed mb-3.5">
                          {res.description}
                        </p>

                        <!-- Tags Footer -->
                        <div class="flex items-center gap-1.5 flex-wrap pt-2 border-t border-slate-100 dark:border-white/[0.04]">
                          <span class="text-[10px] font-mono uppercase text-slate-400 font-semibold mr-1">Tags:</span>
                          {res.tags.map((tag) => (
                            <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-slate-100 dark:bg-white/[0.05] text-slate-600 dark:text-slate-400 border border-slate-200/60 dark:border-white/[0.06]">
                              #{tag}
                            </span>
                          ))}
                        </div>
                      </article>
                    ))}
                  </div>
                </section>
              );
            })
          }
        </div>

        <!-- Empty state when no docs match search -->
        <div id="docs-no-results" class="hidden text-center py-16 px-4 rounded-2xl bg-white dark:bg-[#0e1526]/60 border border-slate-200 dark:border-white/[0.08]">
          <span class="text-4xl mb-3 block">🔍</span>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">No resources found</h3>
          <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto mb-4">
            No resources match your search criteria. Try a different keyword or reset the filter.
          </p>
          <button
            type="button"
            id="docs-reset-search-btn"
            class="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg bg-[#0055ff] hover:bg-[#0047d6] text-white shadow-2xs transition-colors cursor-pointer"
          >
            <span>Reset Search Filter</span>
          </button>
        </div>
      </main>

      <!-- ========================================== -->
      <!-- 3. SYMMETRICAL RIGHT BALANCING SPACER (Invisible) -->
      <!-- Ensures <main> is mathematically centered on the screen -->
      <!-- ========================================== -->
      <div class="hidden lg:block w-64 xl:w-72 shrink-0 pointer-events-none invisible" aria-hidden="true"></div>

    </div>
  </div>
</div>

<script>
  function setupModernDocs() {
    const rootEl = document.getElementById('modern-docs-root');
    if (!rootEl || rootEl.dataset.initialized === 'true') return;
    rootEl.dataset.initialized = 'true';

    const searchInput = document.getElementById('docs-live-search') as HTMLInputElement | null;
    const sidebarFilter = document.getElementById('docs-sidebar-filter') as HTMLInputElement | null;
    const resultsCount = document.getElementById('docs-results-count');
    const noResultsEl = document.getElementById('docs-no-results');
    const resetBtn = document.getElementById('docs-reset-search-btn');
    const tagButtons = rootEl.querySelectorAll<HTMLButtonElement>('.docs-tag-filter');
    const allDocItems = rootEl.querySelectorAll<HTMLElement>('.doc-item');
    const categorySections = rootEl.querySelectorAll<HTMLElement>('.doc-category-group');
    const sidebarCategoryLinks = rootEl.querySelectorAll<HTMLElement>('#docs-sidebar-categories li');
    const copyLinkBtns = rootEl.querySelectorAll<HTMLButtonElement>('.docs-copy-link-btn');

    let activeTag = '';
    const totalCount = allDocItems.length;

    // 1. Live Omnibar Search & Filter
    function performSearch() {
      const query = (searchInput?.value || '').trim().toLowerCase();
      let matches = 0;

      categorySections.forEach((sec) => {
        const items = sec.querySelectorAll<HTMLElement>('.doc-item');
        let sectionMatches = 0;

        items.forEach((item) => {
          const title = item.dataset.title || '';
          const desc = item.dataset.desc || '';
          const tags = item.dataset.tags || '';

          const matchesQuery = !query || title.includes(query) || desc.includes(query) || tags.includes(query);
          const matchesTag = !activeTag || tags.includes(activeTag.toLowerCase());

          if (matchesQuery && matchesTag) {
            item.classList.remove('hidden');
            sectionMatches++;
            matches++;
          } else {
            item.classList.add('hidden');
          }
        });

        if (sectionMatches > 0) {
          sec.classList.remove('hidden');
        } else {
          sec.classList.add('hidden');
        }
      });

      // Update count & empty state
      if (resultsCount) {
        if (!query && !activeTag) {
          resultsCount.textContent = `Showing all ${totalCount} Curated Resources`;
        } else {
          resultsCount.textContent = `Showing ${matches} of ${totalCount} Curated Resources`;
        }
      }

      if (noResultsEl) {
        if (matches === 0) {
          noResultsEl.classList.remove('hidden');
        } else {
          noResultsEl.classList.add('hidden');
        }
      }
    }

    searchInput?.addEventListener('input', performSearch);

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      activeTag = '';
      tagButtons.forEach((btn) => {
        btn.classList.remove('bg-[#0055ff]', 'text-white', 'dark:bg-[#0055ff]');
        btn.classList.add('bg-slate-100', 'dark:bg-white/[0.06]', 'text-slate-600', 'dark:text-slate-400');
      });
      performSearch();
      searchInput?.focus();
    });

    tagButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag || '';
        if (activeTag === tag) {
          activeTag = '';
          btn.classList.remove('bg-[#0055ff]', 'text-white', 'dark:bg-[#0055ff]');
          btn.classList.add('bg-slate-100', 'dark:bg-white/[0.06]', 'text-slate-600', 'dark:text-slate-400');
        } else {
          activeTag = tag;
          tagButtons.forEach((b) => {
            b.classList.remove('bg-[#0055ff]', 'text-white', 'dark:bg-[#0055ff]');
            b.classList.add('bg-slate-100', 'dark:bg-white/[0.06]', 'text-slate-600', 'dark:text-slate-400');
          });
          btn.classList.remove('bg-slate-100', 'dark:bg-white/[0.06]', 'text-slate-600', 'dark:text-slate-400');
          btn.classList.add('bg-[#0055ff]', 'text-white', 'dark:bg-[#0055ff]');
        }
        performSearch();
      });
    });

    // 2. Sidebar Navigation Filter
    sidebarFilter?.addEventListener('input', () => {
      const sq = sidebarFilter.value.trim().toLowerCase();
      sidebarCategoryLinks.forEach((li) => {
        const text = li.textContent?.toLowerCase() || '';
        if (!sq || text.includes(sq)) {
          li.classList.remove('hidden');
        } else {
          li.classList.add('hidden');
        }
      });
    });

    // 3. Permalink Copy Buttons
    copyLinkBtns.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.dataset.id || '';
        if (!id) return;
        const url = `${window.location.origin}${window.location.pathname}#doc-item-${id}`;
        try {
          await navigator.clipboard.writeText(url);
          window.history.replaceState(null, '', `#doc-item-${id}`);
          const iconCopy = btn.querySelector('.icon-copy');
          const iconCheck = btn.querySelector('.icon-check');
          if (iconCopy && iconCheck) {
            iconCopy.classList.add('hidden');
            iconCheck.classList.remove('hidden');
            setTimeout(() => {
              iconCopy.classList.remove('hidden');
              iconCheck.classList.add('hidden');
            }, 1800);
          }
        } catch (_) {}
      });
    });

    // 4. Global Shortcut '/'
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== searchInput && document.activeElement !== sidebarFilter) {
        const activeTagEl = (document.activeElement?.tagName || '').toLowerCase();
        if (activeTagEl !== 'input' && activeTagEl !== 'textarea') {
          e.preventDefault();
          searchInput?.focus();
          searchInput?.select();
        }
      }
    });

    // 5. ScrollSpy for Left Sidebar Navigation Active States
    const sections = rootEl.querySelectorAll<HTMLElement>('.doc-section');
    const navLinks = rootEl.querySelectorAll<HTMLAnchorElement>('.docs-nav-link');

    function updateActiveSection() {
      const scrollPos = window.scrollY + 140;
      let activeId = '';

      sections.forEach((section) => {
        const top = section.offsetTop;
        const height = section.offsetHeight;
        if (scrollPos >= top && scrollPos < top + height) {
          activeId = section.id;
        }
      });

      if (activeId) {
        navLinks.forEach((link) => {
          if (link.dataset.target === activeId) {
            link.classList.add('bg-blue-50', 'dark:bg-white/[0.08]', 'text-[#0055ff]', 'dark:text-[#00d4ff]', 'font-bold');
          } else {
            link.classList.remove('bg-blue-50', 'dark:bg-white/[0.08]', 'text-[#0055ff]', 'dark:text-[#00d4ff]', 'font-bold');
          }
        });
      }
    }

    window.addEventListener('scroll', updateActiveSection, { passive: true });
    updateActiveSection();
  }

  setupModernDocs();
  document.addEventListener('astro:page-load', setupModernDocs);
</script>
