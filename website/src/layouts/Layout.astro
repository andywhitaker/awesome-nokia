---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Awesome Nokia - Curated Tools, Libraries & Resources",
  description = "A curated directory of awesome open-source projects, automation libraries, extensions, and tools for Nokia networking platforms (Containerlab, SR Linux, EDA, NSP, SROS).",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const ogImage = `${baseUrl}/images/nokia-refreshed-logo-2_1.png`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://andywhitaker.github.io');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" type="image/png" href={ogImage} />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Andy Whitaker & Nokia Community" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Web Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Inline Script to prevent FOUC for Dark Theme -->
    <script is:inline>
      (function () {
        try {
          const storedTheme = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          if (storedTheme === 'dark' || (!storedTheme && prefersDark)) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (_) {}
      })();
    </script>
  </head>
  <body class="bg-[#F8FAFC] dark:bg-[#080C14] text-slate-900 dark:text-slate-100 min-h-screen flex flex-col font-sans antialiased selection:bg-[#0055FF] selection:text-white transition-colors duration-150 relative overflow-x-hidden" id="top">
    <!-- Ambient High-Tech Nokia Gradient Glow -->
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-[1536px] h-[650px] overflow-hidden pointer-events-none -z-10 opacity-70 dark:opacity-40">
      <div class="absolute -top-[200px] left-1/2 -translate-x-1/2 w-[900px] h-[500px] bg-gradient-to-b from-[#0055FF]/20 via-[#00D4FF]/10 to-transparent blur-3xl rounded-full"></div>
    </div>
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
